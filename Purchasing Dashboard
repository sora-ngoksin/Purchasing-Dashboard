<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Purchasing Management System</title>
<style>
:root{--nav:#10233f;--blue:#2563eb;--bg:#f4f7fb;--line:#e5e7eb;--text:#172033;--muted:#667085;--green:#16a34a;--orange:#f59e0b;--violet:#7c3aed}
*{box-sizing:border-box}body{margin:0;font-family:Segoe UI,Tahoma,sans-serif;background:var(--bg);color:var(--text)}
.app{display:flex;min-height:100vh}.side{width:230px;background:var(--nav);color:#fff;padding:22px 14px;position:fixed;inset:0 auto 0 0}.brand{font-size:19px;font-weight:700;padding:5px 12px 24px}.brand small{display:block;font-size:11px;color:#9fb2ca;margin-top:5px;font-weight:400}.nav button{width:100%;border:0;background:transparent;color:#cbd5e1;text-align:left;padding:12px 14px;border-radius:8px;margin:3px 0;font-size:14px;cursor:pointer}.nav button:hover,.nav button.active{background:#1e3a5f;color:#fff}.main{margin-left:230px;width:calc(100% - 230px)}header{height:66px;background:#fff;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 28px}.content{padding:28px}.title{font-size:25px;font-weight:700;margin:0}.sub{color:var(--muted);font-size:13px;margin-top:5px}.cards{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin:22px 0}.card,.panel{background:#fff;border:1px solid var(--line);border-radius:12px;box-shadow:0 2px 8px #1018280a}.card{padding:19px}.card b{font-size:27px;display:block;margin:8px 0}.label{font-size:13px;color:var(--muted)}.panel{padding:20px;margin-top:18px}.panel-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px}.panel h3{margin:0;font-size:16px}button.primary{background:var(--blue);color:#fff;border:0;padding:10px 15px;border-radius:7px;cursor:pointer;font-weight:600}table{width:100%;border-collapse:collapse;font-size:13px}th{text-align:left;color:#667085;background:#f9fafb;padding:11px;border-bottom:1px solid var(--line)}td{padding:12px 11px;border-bottom:1px solid #eef0f3}.status{padding:4px 8px;border-radius:99px;font-size:11px;font-weight:600}.approved{background:#dcfce7;color:#166534}.pending{background:#fef3c7;color:#92400e}.draft{background:#e0e7ff;color:#3730a3}.rfq{background:#ede9fe;color:#5b21b6}.page{display:none}.page.active{display:block}.formgrid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}.field label{display:block;font-size:12px;font-weight:600;margin-bottom:6px}.field input,.field select,.field textarea{width:100%;padding:10px;border:1px solid #d0d5dd;border-radius:7px;font:inherit;background:white}.wide{grid-column:1/-1}.actions{text-align:right;margin-top:16px}.empty{padding:25px;text-align:center;color:var(--muted)}@media(max-width:850px){.cards{grid-template-columns:1fr 1fr}.side{width:180px}.main{margin-left:180px;width:calc(100% - 180px)}}
</style></head>
<body><div class="app"><aside class="side"><div class="brand">PURCHASING<small>Management System</small></div><nav class="nav"><button class="active" onclick="showPage('dashboard',this)">▦ Dashboard</button><button onclick="showPage('pr',this)">▤ Purchase Request (PR)</button><button onclick="showPage('rfq',this)">◈ RFQ Management</button></nav></aside>
<main class="main"><header><strong id="headerTitle">Dashboard</strong><span>Purchasing Department</span></header><div class="content">
<section id="dashboard" class="page active"><h1 class="title">Purchasing Dashboard</h1><div class="sub">ภาพรวมงานจัดซื้อและรายการที่ต้องดำเนินการ</div><div class="cards"><div class="card"><span class="label">Open PR</span><b id="openPr">2</b><span class="label">รายการขอซื้อ</span></div><div class="card"><span class="label">RFQ</span><b id="openRfq">2</b><span class="label">กำลังขอราคา</span></div><div class="card"><span class="label">Pending Approval</span><b style="color:var(--orange)">1</b><span class="label">รออนุมัติ</span></div><div class="card"><span class="label">Approved</span><b style="color:var(--green)">1</b><span class="label">อนุมัติแล้ว</span></div></div>
<div class="panel"><div class="panel-head"><h3>Recent Purchase Requests</h3><button class="primary" onclick="go('pr')">+ New PR</button></div><table><thead><tr><th>PR No.</th><th>วันที่</th><th>รายละเอียด</th><th>ผู้ขอ</th><th>ประมาณการ</th><th>Status</th></tr></thead><tbody id="dashPr"></tbody></table></div></section>
<section id="pr" class="page"><h1 class="title">Purchase Request</h1><div class="sub">สร้างและติดตามใบขอซื้อ</div><div class="panel"><div class="panel-head"><h3>รายการ PR</h3><button class="primary" onclick="toggle('prForm')">+ Create PR</button></div><div id="prForm" style="display:none"><div class="formgrid"><div class="field"><label>PR No.</label><input id="prNo" placeholder="PR-2610-001"></div><div class="field"><label>Request Date</label><input id="prDate" type="date"></div><div class="field"><label>Requester</label><input id="requester" placeholder="ชื่อผู้ขอ"></div><div class="field"><label>Department</label><input id="department" placeholder="แผนก"></div><div class="field wide"><label>Description</label><textarea id="description" rows="3" placeholder="รายละเอียดสินค้า / บริการ"></textarea></div><div class="field"><label>Estimated Amount (THB)</label><input id="amount" type="number" min="0"></div><div class="field"><label>Status</label><select id="prStatus"><option>Draft</option><option>Pending Approval</option><option>Approved</option></select></div></div><div class="actions"><button class="primary" onclick="savePR()">Save PR</button></div><hr style="border:0;border-top:1px solid #eee;margin:20px 0"></div><table><thead><tr><th>PR No.</th><th>Date</th><th>Description</th><th>Requester</th><th>Department</th><th>Amount</th><th>Status</th></tr></thead><tbody id="prRows"></tbody></table></div></section>
<section id="rfq" class="page"><h1 class="title">RFQ Management</h1><div class="sub">จัดการ Request for Quotation และ Supplier</div><div class="panel"><div class="panel-head"><h3>รายการ RFQ</h3><button class="primary" onclick="toggle('rfqForm')">+ Create RFQ</button></div><div id="rfqForm" style="display:none"><div class="formgrid"><div class="field"><label>RFQ No.</label><input id="rfqNo" placeholder="RFQ-2610-001"></div><div class="field"><label>Related PR</label><input id="relatedPr" placeholder="PR-2610-001"></div><div class="field"><label>Vendor</label><input id="vendor" placeholder="Supplier / Vendor"></div><div class="field"><label>Due Date</label><input id="dueDate" type="date"></div><div class="field wide"><label>Item / Description</label><textarea id="rfqDesc" rows="3"></textarea></div><div class="field"><label>Quoted Amount (THB)</label><input id="quote" type="number" min="0"></div><div class="field"><label>Status</label><select id="rfqStatus"><option>Open</option><option>Quotation Received</option><option>Closed</option></select></div></div><div class="actions"><button class="primary" onclick="saveRFQ()">Save RFQ</button></div><hr style="border:0;border-top:1px solid #eee;margin:20px 0"></div><table><thead><tr><th>RFQ No.</th><th>PR No.</th><th>Vendor</th><th>Description</th><th>Due Date</th><th>Amount</th><th>Status</th></tr></thead><tbody id="rfqRows"></tbody></table></div></section>
</div></main></div>
<script>
let prs=JSON.parse(localStorage.getItem('pms_prs'))||[{no:'PR-2610-001',date:'2026-10-08',desc:'Microsoft 365 Business Premium',requester:'Sorasak',dept:'IT',amount:85000,status:'Pending Approval'},{no:'PR-2610-002',date:'2026-10-08',desc:'LED Tube',requester:'Sorasak',dept:'Admin',amount:12500,status:'Approved'}];
let rfqs=JSON.parse(localStorage.getItem('pms_rfqs'))||[{no:'RFQ-2609-003',pr:'PR-2610-001',vendor:'Vendor A',desc:'Microsoft 365 Licenses',due:'2026-10-15',amount:85000,status:'Quotation Received'},{no:'RFQ-2610-001',pr:'PR-2610-002',vendor:'Vendor B',desc:'LED Tube',due:'2026-10-12',amount:12500,status:'Open'}];
function money(n){return Number(n||0).toLocaleString('th-TH',{style:'currency',currency:'THB',maximumFractionDigits:0})}function badge(s){let c=s==='Approved'||s==='Closed'?'approved':s.includes('Pending')||s==='Open'?'pending':s==='Draft'?'draft':'rfq';return `<span class="status ${c}">${s}</span>`}
function render(){prRows.innerHTML=prs.map(x=>`<tr><td>${x.no}</td><td>${x.date}</td><td>${x.desc}</td><td>${x.requester}</td><td>${x.dept}</td><td>${money(x.amount)}</td><td>${badge(x.status)}</td></tr>`).join('');dashPr.innerHTML=prs.slice().reverse().slice(0,5).map(x=>`<tr><td>${x.no}</td><td>${x.date}</td><td>${x.desc}</td><td>${x.requester}</td><td>${money(x.amount)}</td><td>${badge(x.status)}</td></tr>`).join('');rfqRows.innerHTML=rfqs.map(x=>`<tr><td>${x.no}</td><td>${x.pr}</td><td>${x.vendor}</td><td>${x.desc}</td><td>${x.due}</td><td>${money(x.amount)}</td><td>${badge(x.status)}</td></tr>`).join('');openPr.textContent=prs.filter(x=>x.status!=='Approved').length;openRfq.textContent=rfqs.filter(x=>x.status!=='Closed').length}
function showPage(id,b){document.querySelectorAll('.page').forEach(x=>x.classList.remove('active'));document.getElementById(id).classList.add('active');document.querySelectorAll('.nav button').forEach(x=>x.classList.remove('active'));if(b)b.classList.add('active');headerTitle.textContent=id==='pr'?'Purchase Request':id==='rfq'?'RFQ Management':'Dashboard'}function go(id){let buttons=[...document.querySelectorAll('.nav button')];showPage(id,buttons[id==='pr'?1:2]);if(id==='pr')prForm.style.display='block'}function toggle(id){let e=document.getElementById(id);e.style.display=e.style.display==='none'?'block':'none'}
function savePR(){if(!prNo.value||!description.value)return alert('กรุณากรอก PR No. และ Description');prs.push({no:prNo.value,date:prDate.value||new Date().toISOString().slice(0,10),desc:description.value,requester:requester.value||'-',dept:department.value||'-',amount:amount.value,status:prStatus.value});localStorage.setItem('pms_prs',JSON.stringify(prs));render();prForm.style.display='none'}
function saveRFQ(){if(!rfqNo.value||!vendor.value)return alert('กรุณากรอก RFQ No. และ Vendor');rfqs.push({no:rfqNo.value,pr:relatedPr.value||'-',vendor:vendor.value,desc:rfqDesc.value||'-',due:dueDate.value||'-',amount:quote.value,status:rfqStatus.value});localStorage.setItem('pms_rfqs',JSON.stringify(rfqs));render();rfqForm.style.display='none'}render();
</script></body></html>
